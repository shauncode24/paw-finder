// PawFinder Firestore security rules.
// Paste this whole file into: Firebase console > Build > Firestore Database > Rules > Publish.
// (See docs/Listers-and-Messaging.md for what each rule is for.)
//
// Summary:
//   users/{uid}              lister profiles: anyone can read, only the owner can write
//                            (the rating totals can only change together with a review)
//   reviews/{applicationId}  a lister's review by the adopter: anyone can read, only the adopter writes
//   listings/{id}            pet listings: anyone can read, only the lister can write
//   listings/{id}/photos/*   the listing's photos (stored inside Firestore, no paid Storage plan needed)
//   conversations/{id}       a chat: only the two people in it
//   conversations/{id}/messages/*   its messages (text, photos, meet-up proposals): only the two people in it
//   applications/{id}        an application: the adopter and the lister it was sent to
//   reports/{id}             reports of listings or chats: anyone can send, nobody can read them in the app

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- Lister profiles ----------------------------------------------------
    // The rating fields belong to the reviews, so the owner can't set or change them.
    function ratingFields() {
      return ['ratingSum', 'ratingCount', 'lastReviewID'];
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(ratingFields());
      allow update: if signedIn() && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(ratingFields());
      allow delete: if signedIn() && request.auth.uid == uid;
      // An adopter's review changes the lister's total, in the same batch as the review:
      //   new review  -> count + 1 and sum + rating
      //   edit        -> count + 0 and sum + (new rating - old rating)
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(ratingFields())
        && getAfter(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewID)).data.listerID == uid
        && getAfter(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewID)).data.reviewerID == request.auth.uid
        && (exists(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewID))
            ? (request.resource.data.get('ratingCount', 0) == resource.data.get('ratingCount', 0)
               && request.resource.data.get('ratingSum', 0) - resource.data.get('ratingSum', 0)
                  == getAfter(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewID)).data.rating
                     - get(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewID)).data.rating)
            : (request.resource.data.get('ratingCount', 0) == resource.data.get('ratingCount', 0) + 1
               && request.resource.data.get('ratingSum', 0) - resource.data.get('ratingSum', 0)
                  == getAfter(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewID)).data.rating));
    }

    // ---- Reviews --------------------------------------------------------------
    // The review's ID is the application's ID, so there is one review per adoption.
    match /reviews/{applicationId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.reviewerID == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.get('text', '').size() <= 500
        && get(/databases/$(database)/documents/applications/$(applicationId)).data.adopterID == request.auth.uid
        && get(/databases/$(database)/documents/applications/$(applicationId)).data.listerID == request.resource.data.listerID
        && get(/databases/$(database)/documents/applications/$(applicationId)).data.status == 'Adopted';
      // The reviewer can change the stars and the text for 7 days.
      allow update: if signedIn()
        && resource.data.reviewerID == request.auth.uid
        && request.time < resource.data.createdAt + duration.value(7, 'd')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'text', 'updatedAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.get('text', '').size() <= 500;
      allow delete: if false;
    }

    // ---- Listings -----------------------------------------------------------
    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerID == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.ownerID == request.auth.uid
                    && request.resource.data.ownerID == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerID == request.auth.uid;

      match /photos/{photoId} {
        allow read: if true;
        // getAfter(): a new listing and its photos are written in one batch,
        // so the listing doesn't exist yet when the photo rule runs.
        allow create, update: if signedIn()
          && getAfter(/databases/$(database)/documents/listings/$(listingId)).data.ownerID == request.auth.uid;
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/listings/$(listingId)).data.ownerID == request.auth.uid;
      }
    }

    // ---- Chats ----------------------------------------------------------------
    match /conversations/{conversationId} {
      // "resource == null" lets the app check whether a chat exists before creating it.
      allow read: if signedIn()
                  && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && conversationId == request.resource.data.listingID + '_' + request.resource.data.adopterID;
      allow update: if signedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        // Sent in the same batch that updates the chat's "last message", hence getAfter().
        // Nobody can send while the chat is blocked.
        allow create: if signedIn()
          && request.resource.data.senderID == request.auth.uid
          && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.blockedBy.size() == 0;
        // Meet-up proposals: either person can accept, decline or cancel by changing
        // only the "status" inside the "meetup" field of a meet-up message.
        allow update: if signedIn()
          && resource.data.meetup != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meetup'])
          && request.resource.data.meetup.diff(resource.data.meetup).affectedKeys().hasOnly(['status']);
      }
    }

    // ---- Applications -----------------------------------------------------------
    match /applications/{applicationId} {
      allow read: if signedIn()
                  && (resource.data.adopterID == request.auth.uid || resource.data.listerID == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.adopterID == request.auth.uid
                    && request.resource.data.status == 'Submitted';
      // The lister moves it along; the adopter can only withdraw it or mark it adopted.
      allow update: if signedIn()
                    && request.resource.data.adopterID == resource.data.adopterID
                    && request.resource.data.listerID == resource.data.listerID
                    && (resource.data.listerID == request.auth.uid
                        || (resource.data.adopterID == request.auth.uid
                            && request.resource.data.status in ['Withdrawn', 'Adopted']));
    }

    // ---- Reports ------------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if true;
    }
  }
}
